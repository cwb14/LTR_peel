# Rerunning the scripts here writes scratch and figure PDFs; keep them out.
tmp/
__pycache__/
*.pyc
figures/*.pdf

# The root .gitignore drops pipeline outputs and results*/ folders made by runs
# inside the repo. Here they are the benchmark's result tables and two small test
# fixtures, which the page cites and the tests read, so they are tracked.
!results/
!tests/fixtures/calls/ltr_peel/*_clean_ltr.tsv

/*
    Per-process publishing and extra arguments.

    Only the reconciled, family-annotated set is published by default. The raw
    per-round tables and .work directories stay in the Nextflow work directory:
    they are large, they are intermediates, and -resume can regenerate anything
    downstream from them.
*/

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[-1].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'LTRQUEST_DETECT' {
        publishDir = [ enabled: false ]
    }

    withName: 'LTRQUEST_MASK' {
        publishDir = [ enabled: false ]
    }

    withName: 'LTRQUEST_RECONCILE' {
        // The depth tables published are the annotated ones; from here only the
        // list of hosts rebuilt around a tenant in one of their LTRs.
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_rejoined.tsv'
        ]
    }

    withName: 'LTRQUEST_CLUSTER' {
        publishDir = [
            path: { "${params.outdir}/families" },
            mode: params.publish_dir_mode,
            pattern: '*_cluster.tsv'
        ]
    }

    withName: 'LTRQUEST_FLAGFP' {
        publishDir = [
            path: { "${params.outdir}/families" },
            mode: params.publish_dir_mode,
            pattern: '*_fpcheck.{log,tandem.tsv}'
        ]
    }

    withName: 'LTRQUEST_RECOVERSTRAND_ALIGN' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_strand_recovery.tsv'
        ]
    }

    withName: 'LTRQUEST_ANNOTATE' {
        publishDir = [
            // With strand recovery on, the re-oriented copy from
            // LTRQUEST_RECOVERSTRAND_APPLY is the one to publish; two processes
            // writing the same names into one directory would race.
            // Switches go through toString().toBoolean(): see workflows/ltrquest.nf.
            enabled: (!params.strand_recovery || params.strand_recovery.toString() in ['off', 'false'])
                && !params.reboundary.toString().toBoolean(),
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_depth*_ltr.tsv'
        ]
    }

    withName: 'LTRQUEST_RECOVERSTRAND_APPLY' {
        publishDir = [
            enabled: !params.reboundary.toString().toBoolean(),
            // The same pattern LTRQUEST_ANNOTATE publishes when recovery is
            // off, so the published set does not change with the flag. The
            // re-oriented FASTAs still flow on to the plotting stage; this
            // path has never published them.
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_depth*_ltr.tsv'
        ]
    }

    withName: 'LTRQUEST_REBOUNDARY' {
        publishDir = [
            // Pooled task with no single meta.id, so each file is sent to its
            // own sample's folder by the prefix in its name (the key the
            // workflow uses to split this task's outputs back out). The
            // re-bounded clean tables replace the annotator's/strand-recovery's,
            // so results/<sample>/ looks the same with or without this step.
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            pattern: '{*_depth*_clean_ltr.tsv,*_reboundary.tsv}',
            saveAs: { fn -> "${fn.replaceFirst(/_(depth\d+_clean_ltr|reboundary)\.tsv$/, '')}/${fn}" }
        ]
    }

    withName: 'LTRQUEST_GFF3' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.gff3'
        ]
    }

    withName: 'LTRQUEST_PLOTS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_plots'
        ]
    }
}
